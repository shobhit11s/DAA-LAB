#include <stdio.h>
#include <stdlib.h>

int main() {
    int n;
    if (scanf("%d", &n) != 1) return 0;

    int *values = (int *)malloc(n * sizeof(int));
    int *weights = (int *)malloc(n * sizeof(int));

    for (int i = 0; i < n; i++) {
        scanf("%d", &values[i]);
    }

    for (int i = 0; i < n; i++) {
        scanf("%d", &weights[i]);
    }

    int w;
    scanf("%d", &w);

    int *dp = (int *)calloc(w + 1, sizeof(int));

    for (int i = 0; i < n; i++) {
        for (int j = w; j >= weights[i]; j--) {
            if (dp[j - weights[i]] + values[i] > dp[j]) {
                dp[j] = dp[j - weights[i]] + values[i];
            }
        }
    }

    printf("%d\n", dp[w]);

    free(values);
    free(weights);
    free(dp);

    return 0;
}

